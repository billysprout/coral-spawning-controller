# Sandbox and test image: the tank image's base plus pytest and Pillow (the
# WheelGlyphs tests need it). Used only by the `sandbox` and `test` compose
# profiles; the live tank keeps its own image (Dockerfile).
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/*
ENV TZ=America/Los_Angeles \
    PYTHONDONTWRITEBYTECODE=1 \
    TANK_IN_CONTAINER=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest==8.3.3 pillow==10.4.0

COPY scripts/ ./scripts/
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests", "--ignore=tests/soak"]
