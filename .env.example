# Settings for the tank stack. Copy this file to a file named .env in the same
# folder (the top of the repo), then fill in only what you use:
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed: it holds your tokens.
# An empty value switches that feature off. Nothing here is needed to start;
# without any alert channel the controller still runs, but nobody hears an alarm.
# Docker reads .env when you run `docker compose`; after a change, run
# scripts/start.sh again (or `docker compose up -d <service>`) to apply it.

# --------------------------------------------------------------------------
# Alerts: where the controller sends "something is wrong" messages.
# Optional, but set at least one channel. Every channel that is filled in
# gets every alert.
# --------------------------------------------------------------------------

# Telegram (recommended). Make a bot with @BotFather to get the token. Send
# your bot one message, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# in a browser; the number after "chat":{"id": is your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover (paid phone app). Both values are needed.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ntfy.sh (free phone app). Pick a long, hard-to-guess topic name: anyone who
# knows the topic can read your alerts.
NTFY_TOPIC=

# Dead-man switch: a ping URL from a service such as healthchecks.io. The
# controller pings it every cycle; if the pings stop (PC off, Docker stopped,
# controller crashed) that service alerts you. This is the only alert that still
# works when this computer is dead, so it is worth setting.
TANK_DEADMAN_URL=

# --------------------------------------------------------------------------
# Daily feed (optional): one Telegram message a day at noon with the tank's
# temperature and light, on a SECOND bot (not the alert bot above).
# The feed runs only when both values are filled in.
# --------------------------------------------------------------------------
reeflive_token=
TELEGRAM_FEED_CHAT_ID=

# --------------------------------------------------------------------------
# Cue tables: where the reef cue tables come from (scripts/cue_import.py).
# On the first start the controller downloads them from this repository and
# installs them in data/ (no token needed: the repository is public). Pin a
# tag in CUE_TABLES_REF for a fixed set; main follows the latest. 0 in
# CUE_TABLES_AUTO_IMPORT switches the download off (import by hand with
# `python scripts/cue_import.py fetch --from-dir <a local copy>`).
# --------------------------------------------------------------------------
CUE_TABLES_URL=https://github.com/realfakedoors-idaho/reef-cue-tables
CUE_TABLES_REF=main
CUE_TABLES_AUTO_IMPORT=1

# --------------------------------------------------------------------------
# Cue-data check at controller start (scripts/data_manifest.py).
#   warn     start anyway and raise the data_manifest_mismatch alert (default)
#   enforce  refuse to start when the audited cue files do not match
# --------------------------------------------------------------------------
DATA_MANIFEST_MODE=warn

# --------------------------------------------------------------------------
# Lifeguard (the independent watchdog, scripts/lifeguard.py). Optional: its
# own dead-man ping URL, a SECOND check at a service such as healthchecks.io,
# so you also hear when the watchdog itself stops.
# --------------------------------------------------------------------------
LIFEGUARD_DEADMAN_URL=

# --------------------------------------------------------------------------
# Outdoor-air recorder. It is fixed to the original owner's US zip code, so it
# is off here. 1 switches it on.
# --------------------------------------------------------------------------
TANK_AMBIENT=0
